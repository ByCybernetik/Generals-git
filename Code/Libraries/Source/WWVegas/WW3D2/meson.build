_linux_d3dx_compat = meson.project_source_root() / 'Code' / 'platform' / 'linux' / 'linux_d3dx_compat.h'

_ww3d2_inc = [
  '.',
  'mingw',
  'linux',
  '../../../../platform',
  '../../../../platform/linux',
  '../../../../../third_party/stb',
  '../WWLib',
  '../WWLib/mingw',
  '../WWDebug',
  '../WWMath',
  '../WWSaveLoad',
  '../Wwutil',
  '../WWAudio',
]

inc = include_directories(_ww3d2_inc)

_ww3d2_cpp = []
foreach _arg : generals_cpp_args
  if _arg != '-std=gnu++11'
    _ww3d2_cpp += _arg
  endif
endforeach
_ww3d2_cpp += [
  '-std=gnu++11',
  '-include', _linux_d3dx_compat,
  '-DRENEGADE_WW3D2_BUILD',
]
if get_option('graphics_backend') == 'vulkan'
  _ww3d2_cpp += '-I' + (meson.current_source_dir() / '..' / 'ww3d2_vulkan')
endif
_ww3d2_deps = [linux_graphics_dep]
if get_option('graphics_backend') == 'vulkan'
  _ww3d2_cpp += ['-DRENEGADE_VULKAN', '-DGENERALS_VULKAN']
  _ww3d2_deps += [ww3d2_vulkan_dep]
endif

ww3d2_lib = static_library(
  'ww3d2',
  ww3d2_sources,
  include_directories : inc,
  dependencies : _ww3d2_deps,
  cpp_args : _ww3d2_cpp,
  link_args : generals_link_args,
  override_options : ['cpp_std=gnu++11'],
)
